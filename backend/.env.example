# Copier en .env (jamais versionné). Toutes les variables ont le préfixe OCR_.

# Base de données : MariaDB en production (créée par deploy/windows/install.ps1).
OCR_DATABASE_URL=mysql+pymysql://ocr_app:MOT_DE_PASSE@127.0.0.1:3306/ocr?charset=utf8mb4

# Clé de signature des jetons : générée à l'installation (>= 32 caractères aléatoires).
OCR_SECRET_KEY=

# Dossier des fichiers (hors de la racine web). Chiffré au repos par BitLocker (voir docs/SECURITE.md).
OCR_DATA_DIR=D:/ocr_data

# true derrière HTTPS (production).
OCR_COOKIE_SECURE=true

# Dossier Release de llama.cpp (contient llama-server.exe compilé pour la carte : arch 61 en dev, 86 en production).
OCR_LLAMA_CPP_DIR=C:/LLAMA.CPP.CUDA/llama.cpp/build/bin/Release
OCR_LLAMA_PORT=8081

# Moteur OCR : surya2 (production) ou dummy (démonstration sans GPU).
OCR_OCR_BACKEND=surya2

# Ollama local (le modèle de correction se choisit dans Administration > Paramètres).
OCR_OLLAMA_URL=http://127.0.0.1:11434

# Hors ligne : aucun téléchargement à l'exécution.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HOME=D:/ocr_data/hf
