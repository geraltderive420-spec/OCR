# Copier en .env (jamais versionné). Toutes les variables ont le préfixe OCR_.
# Sur la station, backend/.env est créé par l'installation (configurer.py) et les chemins viennent de ocr_env.bat.

# Clé de signature des jetons (>= 32 caractères aléatoires). Générer :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OCR_SECRET_KEY=

# Dossier des données : base SQLite (db/ocr.sqlite3), fichiers, journaux. Défaut : backend/data.
# Sur un disque chiffré (BitLocker) en production.
# OCR_DATA_DIR=D:/ocr_data

# Autre base que SQLite (inutile en général) : OCR_DATABASE_URL=sqlite:///D:/chemin/autre.sqlite3

# Accès : local seulement par défaut. HTTPS si un certificat est fourni (deploy/windows/make_cert.py).
# Par défaut : API 0.0.0.0:8085, interface 0.0.0.0:3050, llama.cpp 127.0.0.1:8091 (second lecteur 8092).
# OCR_API_HOST=0.0.0.0
# OCR_API_PORT=8085
# OCR_FRONTEND_PORT=3050
# OCR_SSL_CERTFILE=C:/OCR/certs/server.crt
# OCR_SSL_KEYFILE=C:/OCR/certs/server.key
# true seulement si l'application est servie en HTTPS.
OCR_COOKIE_SECURE=false

# Moteur OCR : surya2 (production) ou dummy (démonstration sans GPU).
OCR_OCR_BACKEND=surya2

# llama.cpp : valeurs PAR DÉFAUT, modifiables ensuite dans Administration > Moteur OCR.
# OCR_LLAMA_CPP_DIR=C:/LLAMA.CPP.CUDA/llama.cpp/build/bin/Release
# OCR_LLAMA_CPP_CPU_DIR=
# OCR_LLAMA_PORT=8091
# OCR_LLAMA_HOST=127.0.0.1
# OCR_PAGE_WIDTH=0
# OCR_LLAMA_PARALLEL=1

# Ollama local (le modèle de correction se choisit dans Administration > Paramètres).
OCR_OLLAMA_URL=http://127.0.0.1:11434

# Hors ligne : aucun téléchargement à l'exécution.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# HF_HOME=D:/ocr_data/hf
# MODEL_CACHE_DIR=D:/ocr_data/datalab
